# ANTHROPIC_API_KEY: Required for Claude AI API calls (replaces the original GEMINI_API_KEY).
ANTHROPIC_API_KEY="sk-ant-..."

# ANTHROPIC_MODEL: Optional, defaults to claude-sonnet-5 if not set.
ANTHROPIC_MODEL="claude-sonnet-5"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Optional — required only for the "Vista Explodida" (exploded
# view simulation) feature, which calls Google's image generation API
# (Gemini 2.5 Flash Image) since Claude/Anthropic does not generate images.
# Get a key at https://aistudio.google.com/apikey. Without it, every other
# feature works normally; only exploded-view generation returns a clear
# configuration-pending error.
GEMINI_API_KEY="AIza..."
