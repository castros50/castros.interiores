<div class="card">
  <h2>Pôster</h2>
  <p style="color:#6a6258; font-size:0.9rem;">Usa o título, texto e CTA definidos na aba "Campanha".</p>

  <% if (campanhaAtiva.titulo || campanhaAtiva.poster_foto_id) { %>
    <div style="margin-bottom:14px;">
      <strong style="font-size:0.85rem; display:block; margin-bottom:6px;">Pôster pronto:</strong>
      <img src="/julia/campanhas/<%= campanhaAtiva.id %>/poster.png?v=<%= campanhaAtiva.atualizado_em %>"
           alt="Pôster gerado" data-ampliar
           style="max-width:320px; width:100%; border-radius:8px; border:1px solid var(--cor-borda);">
    </div>
  <% } else { %>
    <p style="color:#6a6258; font-size:0.85rem;">
      Preencha pelo menos o título na aba "Campanha" para o pôster ser gerado aqui.
    </p>
  <% } %>

  <form method="post" action="/julia/campanhas/<%= campanhaAtiva.id %>/poster">
    <div class="grid cols-2">
      <div class="campo">
        <label>Foto da biblioteca</label>
        <select name="foto_id">
          <option value="">— nenhuma —</option>
          <% fotos.forEach(function(f) { %>
            <option value="<%= f.id %>" <%= String(f.id) === String(campanhaAtiva.poster_foto_id) ? 'selected' : '' %>><%= f.tag %><%= f.legenda ? (' — ' + f.legenda) : '' %> (#<%= f.id %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="campo">
        <label>Cor/tema</label>
        <select name="tema">
          <% Object.keys(temas).forEach(function(chave) { %>
            <option value="<%= chave %>" <%= campanhaAtiva.poster_tema === chave ? 'selected' : '' %>><%= temas[chave].rotulo %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <button type="submit">Salvar pôster</button>
  </form>

  <div class="botoes" style="margin-top:12px;">
    <a class="botao" href="/julia/campanhas/<%= campanhaAtiva.id %>/poster.png" target="_blank">Baixar pôster em PNG</a>
  </div>
</div>
