<div class="card">
  <h2>Conversar com a Júlia</h2>
  <p style="color:#6a6258; font-size:0.9rem;">
    Fale ou escreva em português normal o que você quer — ex.: "cria uma campanha para o sofá
    Chesterfield", "coloca essa última foto na lâmina 2 com o tema noite e ouro" ou "agenda esse
    post para sexta às 9h no WhatsApp". A Júlia confirma antes de sobrescrever algo que já está
    preenchido, nunca inventa preço ou dado que não foi informado, e nenhuma publicação é enviada
    automaticamente — ela só planeja.
  </p>
  <% if (campanhaAtiva) { %>
    <p style="font-size:0.85rem;">Conversando sobre a campanha: <strong><%= campanhaAtiva.nome %></strong></p>
  <% } else { %>
    <p style="font-size:0.85rem; color:#6a6258;">Nenhuma campanha selecionada ainda — peça para a Júlia criar uma, ou escolha uma acima.</p>
  <% } %>
</div>

<div class="card">
  <div id="julia-chat-mensagens" style="display:flex; flex-direction:column; gap:10px; max-height:55vh; overflow-y:auto; padding:4px;">
    <% if (!chatMensagens.length) { %>
      <p style="color:#6a6258; font-size:0.9rem;">Nenhuma mensagem ainda — comece escrevendo ou tocando no microfone abaixo.</p>
    <% } %>
    <% chatMensagens.forEach(function(m) { %>
      <div style="align-self:<%= m.remetente === 'julia' ? 'flex-start' : 'flex-end' %>; max-width:80%;
                  background:<%= m.remetente === 'julia' ? '#faf8f5' : 'var(--cor-destaque, #2f6f4f)' %>;
                  color:<%= m.remetente === 'julia' ? '#2b2621' : '#fff' %>;
                  border:1px solid var(--cor-borda); border-radius:12px; padding:10px 14px;">
        <div style="font-size:0.72rem; opacity:0.75; margin-bottom:3px;"><%= m.remetente === 'julia' ? 'Júlia' : 'Você' %></div>
        <div style="white-space:pre-line; font-size:0.92rem;"><%= m.texto %></div>
      </div>
    <% }) %>
  </div>

  <form method="post" action="/julia/chat" id="julia-chat-form" style="margin-top:14px;">
    <input type="hidden" name="campanha_id" value="<%= campanhaId %>">
    <div class="campo">
      <textarea name="mensagem" id="julia-chat-mensagem" placeholder="Escreva ou toque no microfone para falar..." required style="min-height:70px;"></textarea>
    </div>
    <div class="carregando"><span class="spinner"></span> A Júlia está trabalhando nisso...</div>
    <div class="botoes">
      <button type="submit">Enviar</button>
      <button type="button" class="botao secundario" data-mic-alvo="#julia-chat-mensagem">🎤 Falar</button>
    </div>
  </form>
</div>

<script>
  (function () {
    var lista = document.getElementById('julia-chat-mensagens');
    if (lista) lista.scrollTop = lista.scrollHeight;
  })();
</script>
