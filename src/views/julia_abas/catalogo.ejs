<div class="card">
  <h2>Catálogo digital</h2>
  <div class="botoes">
    <a class="botao" href="/julia/campanhas/<%= campanhaAtiva.id %>/catalogo.pdf" target="_blank">Baixar catálogo em PDF A4</a>
  </div>
</div>

<div class="card">
  <h3>Adicionar produto</h3>
  <form method="post" action="/julia/campanhas/<%= campanhaAtiva.id %>/catalogo/itens">
    <div class="grid cols-2">
      <div class="campo"><label>Nome do produto</label><input type="text" name="titulo" required></div>
      <div class="campo"><label>Categoria</label><input type="text" name="categoria" placeholder="Sofá, poltrona, cadeira..."></div>
    </div>
    <div class="grid cols-2">
      <div class="campo"><label>Coleção</label><input type="text" name="colecao"></div>
      <div class="campo"><label>Medidas (opcional)</label><input type="text" name="medidas"></div>
    </div>
    <div class="campo"><label>Descrição</label><textarea name="descricao"></textarea></div>
    <div class="grid cols-2">
      <div class="campo"><label>Cores disponíveis</label><input type="text" name="cores"></div>
      <div class="campo"><label>Preço (opcional — deixe em branco se não quiser exibir)</label><input type="text" name="preco_texto" placeholder="Ex.: R$ 2.500,00"></div>
    </div>
    <div class="campo"><label>Destaque (opcional)</label><input type="text" name="destaque" placeholder="Ex.: Lançamento"></div>
    <button type="submit">Adicionar produto</button>
  </form>
</div>

<% campanhaAtiva.itensCatalogo.forEach(function(item) { %>
  <div class="card">
    <h3><%= item.titulo %></h3>
    <div class="fotos-grade" style="margin-bottom:10px;">
      <% item.fotos.forEach(function(f) { %>
        <div class="foto-card">
          <img src="/julia/fotos/<%= f.id %>/arquivo" alt="Foto do produto" data-ampliar>
          <form method="post" action="/julia/campanhas/<%= campanhaAtiva.id %>/catalogo/itens/<%= item.id %>/fotos/<%= f.vinculo_id %>/excluir" style="padding:0 6px 6px;">
            <button type="submit" class="botao perigo pequeno">Remover</button>
          </form>
        </div>
      <% }) %>
    </div>

    <form method="post" action="/julia/campanhas/<%= campanhaAtiva.id %>/catalogo/itens/<%= item.id %>/fotos" enctype="multipart/form-data">
      <div class="grid cols-2">
        <div class="campo">
          <label>Adicionar foto da biblioteca</label>
          <select name="foto_biblioteca_id">
            <option value="">— nenhuma —</option>
            <% fotos.forEach(function(f) { %><option value="<%= f.id %>"><%= f.tag %> (#<%= f.id %>)</option><% }) %>
          </select>
        </div>
        <div class="campo">
          <label>Ou enviar nova(s) foto(s)</label>
          <input type="file" name="fotos" accept="image/*" multiple>
        </div>
      </div>
      <button type="submit" class="botao secundario pequeno">Adicionar foto(s)</button>
    </form>

    <form method="post" action="/julia/campanhas/<%= campanhaAtiva.id %>/catalogo/itens/<%= item.id %>/editar" style="margin-top:10px;">
      <div class="grid cols-2">
        <div class="campo"><label>Nome</label><input type="text" name="titulo" value="<%= item.titulo %>" required></div>
        <div class="campo"><label>Categoria</label><input type="text" name="categoria" value="<%= item.categoria || '' %>"></div>
      </div>
      <div class="grid cols-2">
        <div class="campo"><label>Coleção</label><input type="text" name="colecao" value="<%= item.colecao || '' %>"></div>
        <div class="campo"><label>Medidas</label><input type="text" name="medidas" value="<%= item.medidas || '' %>"></div>
      </div>
      <div class="campo"><label>Descrição</label><textarea name="descricao"><%= item.descricao || '' %></textarea></div>
      <div class="grid cols-2">
        <div class="campo"><label>Cores</label><input type="text" name="cores" value="<%= item.cores || '' %>"></div>
        <div class="campo"><label>Preço (opcional)</label><input type="text" name="preco_texto" value="<%= item.preco_texto || '' %>"></div>
      </div>
      <div class="campo"><label>Destaque</label><input type="text" name="destaque" value="<%= item.destaque || '' %>"></div>
      <div class="botoes">
        <button type="submit" class="botao secundario pequeno">Salvar alterações</button>
      </div>
    </form>
    <form method="post" action="/julia/campanhas/<%= campanhaAtiva.id %>/catalogo/itens/<%= item.id %>/excluir" data-confirmar="Excluir este produto do catálogo?">
      <button type="submit" class="botao perigo pequeno">Excluir produto</button>
    </form>
  </div>
<% }) %>
