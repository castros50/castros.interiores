<%- include('partials/head', { titulo: 'Atendimentos' }) %>
<%- include('partials/header') %>
<div class="container">
  <div class="botoes" style="margin-bottom:16px;">
    <a class="botao" href="/atendimentos/novo">+ Novo atendimento</a>
    <a class="botao secundario" href="/analise-rapida">Avaliação rápida (foto + IA)</a>
    <a class="botao secundario" href="/departamentos">Central de Agentes</a>
  </div>

  <div class="card lista-atendimentos">
    <h1>Atendimentos</h1>
    <% if (atendimentos.length === 0) { %>
      <p>Nenhum atendimento cadastrado ainda. Clique em "Novo atendimento" para começar.</p>
    <% } %>
    <% atendimentos.forEach(function(a) { %>
      <a class="item" href="/atendimentos/<%= a.id %>">
        <div>
          <strong><%= a.numero %></strong> — <%= a.cliente_nome || 'Cliente não informado' %>
          <div style="font-size:0.8rem; color:#6a6258;"><%= a.tipo_movel || 'Tipo de móvel não informado' %> · atualizado em <%= a.atualizado_em %></div>
        </div>
        <span class="selo <%= a.status %>"><%= statusRotulos[a.status] || a.status %></span>
      </a>
    <% }) %>
  </div>
</div>
<%- include('partials/footer') %>
