# Porta do servidor
PORT=3000

# Chave usada para assinar a sessão de login (defina um valor longo e aleatório)
SESSION_SECRET=troque-este-valor-por-um-segredo-aleatorio-longo

# Usuário responsável inicial (criado apenas se não houver nenhum usuário ainda)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# Integração com IA (Anthropic / Claude) para análise de fotos.
# Sem ANTHROPIC_API_KEY, o botão "Analisar fotos" mostra "IA não configurada"
# e nenhum resultado de análise é exibido.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
